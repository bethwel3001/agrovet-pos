# WhatsApp number the "Open WhatsApp" buttons link to (international format, no +).
#
# While this is unset or left at the 254700000000 placeholder, the buttons do NOT
# navigate — they raise a "WhatsApp is not connected yet" toast instead. Set a real
# number here to turn them into live wa.me links.
VITE_WHATSAPP_NUMBER=254700000000

# Message pre-filled in the user's WhatsApp composer
VITE_WHATSAPP_PREFILL=Hi, I run an agrovet and I want to try AgroVet POS.
