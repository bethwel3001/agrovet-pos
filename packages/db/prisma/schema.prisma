generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Shop ──────────────────────────────────────────────────────────────
model Shop {
  id          String   @id @default(cuid())
  name        String
  kraPin      String   @unique
  phoneNumber String   @unique // WhatsApp number: 2547XXXXXXXX (no +)
  address     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products  Product[]
  sales     Sale[]
  stockLogs StockLog[]
  users     User[]
}

// ── User (back office login) ──────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  shopId       String
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(STAFF)
  createdAt    DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id])
}

// ── Product ───────────────────────────────────────────────────────────
model Product {
  id            String   @id @default(cuid())
  shopId        String
  name          String
  aliases       String[] // ["dap", "dap fertilizer", "diammonium phosphate"]
  unit          String   // "bag" | "litre" | "kg" | "piece"
  defaultPrice  Decimal  @db.Decimal(12, 2)
  stockQty      Int      @default(0)
  lowStockAlert Int      @default(5)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shop      Shop       @relation(fields: [shopId], references: [id])
  saleItems SaleItem[]
  stockLogs StockLog[]

  @@unique([shopId, name])
}

// ── Sale ──────────────────────────────────────────────────────────────
model Sale {
  id            String     @id @default(cuid())
  shopId        String
  invoiceNumber String?    @unique // from KRA eTIMS (null until issued)
  controlCode   String?    // KRA intrlData
  qrCodeData    String?    // KRA rcptSign (for QR)
  subtotal      Decimal    @db.Decimal(12, 2)
  vatAmount     Decimal    @db.Decimal(12, 2)
  totalAmount   Decimal    @db.Decimal(12, 2)
  status        SaleStatus @default(PENDING)
  whatsappFrom  String     // phone number that triggered the sale
  receiptPath   String?    // local path to generated PNG
  createdAt     DateTime   @default(now())

  shop  Shop       @relation(fields: [shopId], references: [id])
  items SaleItem[]
}

// ── SaleItem ──────────────────────────────────────────────────────────
model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  productId String
  qty       Int
  unitPrice Decimal @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

// ── StockLog ──────────────────────────────────────────────────────────
model StockLog {
  id        String       @id @default(cuid())
  shopId    String
  productId String
  type      StockLogType // IN | OUT
  qty       Int
  note      String?
  createdAt DateTime     @default(now())

  shop    Shop    @relation(fields: [shopId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

// ── Enums ─────────────────────────────────────────────────────────────
enum SaleStatus {
  PENDING   // confirmation sent, awaiting YES
  INVOICED  // KRA eTIMS invoice issued, receipt sent
  FAILED    // KRA call failed
  CANCELLED // owner did not confirm
}

enum StockLogType {
  IN
  OUT
}

enum UserRole {
  OWNER
  STAFF
}
