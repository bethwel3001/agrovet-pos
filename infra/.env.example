# ── App ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
JWT_SECRET=change_me_to_a_long_random_string_before_production

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agrovet
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agrovet

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── OpenWA Gateway (https://github.com/rmyndharis/OpenWA) ────────────
OPENWA_BASE_URL=http://localhost:2785
OPENWA_API_KEY=your_openwa_api_key_from_dashboard
OPENWA_SESSION_NAME=agrovet-bot

# ── KRA eTIMS (Sandbox) ───────────────────────────────────────────────
# Sign up at: https://etims-sb.kra.go.ke
KRA_BASE_URL=https://etims-api-sb.kra.go.ke
KRA_PIN=A000000000A
KRA_BRANCH_ID=00
KRA_TOKEN=your_etims_bearer_token

# ── Receipt ───────────────────────────────────────────────────────────
RECEIPTS_DIR=./receipts

# ── CORS (back office origin) ─────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
